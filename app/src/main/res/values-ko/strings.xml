    <!-- Common Dialogs -->
    <string name="stop_extraction_dialog_title">압축 해제를 중지하시겠습니까?</string>
    <string name="stop_extraction_dialog_body_hatch">제자리(In-Place) 압축 해제가 이미 원본 아카이브를 수정했을 수 있습니다. 지금 중지하면 남은 아카이브를 읽을 수 없게 되고 미완료 파일을 복구하지 못할 수 있습니다.</string>
    <string name="stop_extraction_dialog_body_standard">압축 해제가 중지되지만 원본 아카이브는 그대로 유지됩니다. 완료되지 않은 출력 파일은 다시 압축 해제해야 할 수 있습니다.</string>
    <string name="stop_extraction_confirm_hatch">그래도 중지</string>
    <string name="stop_extraction_confirm_standard">압축 해제 중지</string>
    <string name="stop_extraction_keep_extracting">계속 압축 해제</string>

    <string name="dialog_persistent_folder_extract_title">먼저 영구 폴더를 선택하세요</string>
    <string name="dialog_persistent_folder_extract_body">영구 폴더 액세스가 아직 선택되지 않았습니다. KaiHatch가 저장소에 직접 파일을 풀 수 있도록 대상 폴더(예: Download 또는 사용자 지정 폴더)를 선택해 주세요.\n\n폴더를 선택하면 즉시 압축 해제가 자동으로 시작됩니다.</string>
    <string name="dialog_persistent_folder_extract_confirm">폴더 선택 및 압축 해제</string>

    <string name="dialog_output_folder_title">먼저 출력 폴더를 선택하세요</string>
    <string name="dialog_output_folder_compress_body">KaiHatch가 생성된 아카이브를 기기 저장소에 직접 자동 저장할 수 있도록 대상 폴더(압축 해제에 사용되는 것과 동일한 출력 폴더)를 선택해 주세요.</string>
    <string name="dialog_output_folder_compress_confirm">폴더 선택 및 압축</string>
    <string name="dialog_output_folder_explorer_body">선택한 파일을 KaiHatch가 저장소에 직접 풀 수 있도록 대상 폴더를 선택해 주세요.</string>

    <string name="dialog_delete_folder_title">압축 해제된 폴더를 삭제하시겠습니까?</string>
    <string name="dialog_delete_folder_body">\"%1$s\" 폴더와 압축 해제된 모든 파일을 영구적으로 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다.</string>
    <string name="dialog_delete_file_title">파일을 삭제하시겠습니까?</string>
    <string name="dialog_delete_file_body">\"%1$s\" 파일을 영구적으로 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다.</string>

    <string name="dialog_inplace_confirm_title">제자리 압축 해제는 원본 아카이브를 소모합니다</string>
    <string name="dialog_inplace_confirm_body">제자리(In-Place) 압축 해제는 파일이 풀릴 때마다 원본 아카이브(\"%1$s\")를 점진적으로 축소하고 제거하여 디스크 공간을 절약합니다.\n\n압축 해제가 완료되면 원본 아카이브는 남지 않습니다. 원본 아카이브를 그대로 유지하려면 표준 압축 해제를 선택하세요.</string>
    <string name="dialog_inplace_use_standard">표준 사용</string>
    <string name="dialog_inplace_use_inplace">제자리 사용</string>

