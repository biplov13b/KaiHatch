    <string name="dialog_persistent_folder_extract_confirm">选择文件夹并解压</string>

    <string name="dialog_output_folder_title">请先选择输出文件夹</string>
    <string name="dialog_output_folder_compress_body">请选择一个目标文件夹（与解压使用的输出文件夹相同），以便 KaiHatch 将创建的压缩包直接自动保存到您的设备存储中。</string>
