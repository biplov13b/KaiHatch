<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ (API 33+) runtime permission for extraction and compression notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+ (API 36+) permission for promoted Live Updates in status bar chip and lockscreen -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Foreground service & WakeLock permissions to prevent OS background CPU/IO throttling -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Optional All Files Access (Android 11+ / API 30+) for verified direct filesystem extraction and crash-safe recovery on Internal Storage and Downloads -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Exclusively for official GitHub update checks and verified APK downloads (extraction remains 100% offline) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- User-approved native package installer handoff for verified official updates -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="content" android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="content" />
        </intent>
    </queries>

    <application
        android:name=".KaiHatchApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.App.Starting">

        <!-- Default Notification Icon & Accent Color -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|locale|layoutDirection"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- MIME-based intent filter for supported archive formats -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <!-- ZIP formats -->
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <!-- 7-Zip formats -->
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-7z" />
                <!-- TAR formats -->
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/tar" />
                <!-- GZIP / TGZ formats -->
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/x-gunzip" />
                <data android:mimeType="application/gzipped" />
                <data android:mimeType="application/gzip-compressed" />
                <data android:mimeType="application/x-compressed-tar" />
                <data android:mimeType="application/x-gtar" />
                <data android:mimeType="application/x-tgz" />
                <!-- Android Packages (ZIP) -->
                <data android:mimeType="application/vnd.android.package-archive" />
                <!-- RAR formats -->
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-rar" />
                <data android:mimeType="application/rar" />
            </intent-filter>

            <!-- Extension / pathSuffix fallback filters when file managers send generic MIME types (e.g. application/octet-stream or */*) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\.ZIP" />
                <data android:pathPattern=".*\\.7z" />
                <data android:pathPattern=".*\\.7Z" />
                <data android:pathPattern=".*\\.tar" />
                <data android:pathPattern=".*\\.TAR" />
                <data android:pathPattern=".*\\.tar\\.gz" />
                <data android:pathPattern=".*\\.TAR\\.GZ" />
                <data android:pathPattern=".*\\.tgz" />
                <data android:pathPattern=".*\\.TGZ" />
                <data android:pathPattern=".*\\.gz" />
                <data android:pathPattern=".*\\.GZ" />
                <data android:pathPattern=".*\\.apk" />
                <data android:pathPattern=".*\\.APK" />
                <data android:pathPattern=".*\\.xapk" />
                <data android:pathPattern=".*\\.XAPK" />
                <data android:pathPattern=".*\\.rar" />
                <data android:pathPattern=".*\\.RAR" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable eager cold-start WorkManager initialization; KaiHatchApplication initializes it on-demand -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver
            android:name=".data.HatchNotificationCancelReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.biplov.kaihatch.ACTION_CANCEL_TASK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".updater.UpdateActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.biplov.kaihatch.ACTION_DOWNLOAD_UPDATE" />
                <action android:name="com.biplov.kaihatch.ACTION_CANCEL_UPDATE_DOWNLOAD" />
            </intent-filter>
        </receiver>

        <service
            android:name=".data.HatchForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
